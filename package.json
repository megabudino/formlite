{
	"name": "freeform",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "npm@10.9.4",
	"engines": {
		"node": ">=20",
		"npm": ">=10"
	},
	"scripts": {
		"preinstall": "node -e \"const ua=(process.env.npm_config_user_agent||'').split('/')[0];if(ua&&ua!=='npm'){console.error('\\nThis project requires npm (detected: '+ua+'). Run: npm install\\n');process.exit(1);}\"",
		"dev": "DEPLOY_TARGET=app vite dev --configLoader native",
		"dev:marketing": "DEPLOY_TARGET=marketing vite dev --configLoader native",
		"build": "DEPLOY_TARGET=app vite build --configLoader native",
		"build:marketing": "DEPLOY_TARGET=marketing vite build --configLoader native",
		"preview": "DEPLOY_TARGET=app vite preview --configLoader native",
		"preview:marketing": "DEPLOY_TARGET=marketing vite preview --configLoader native",
		"prepare": "DEPLOY_TARGET=${DEPLOY_TARGET:-app} svelte-kit sync || echo ''",
		"check": "DEPLOY_TARGET=app svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:marketing": "DEPLOY_TARGET=marketing svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "DEPLOY_TARGET=app svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:init": "npx tsx scripts/init-db.ts",
		"test:migrations": "node --import tsx --test tests/migrations.test.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"better-auth": "^1.4.15",
		"better-sqlite3": "^12.6.2"
	}
}
