<script lang="ts">
	import {
		LandingHeader,
		Hero,
		ProductShowcase,
		PainPoints,
		Bridge,
		CoreOffer,
		Team,
		FinalCta,
		Footer
	} from '$lib/landing';

	const siteUrl = 'https://www.formlite.org';
	const siteName = 'Formlite';
	const pageTitle = 'Formlite. The form backend you actually own.';
	const pageDescription =
		'Formlite is the open source, self hosted alternative to Formspree. Point your HTML form at an endpoint, receive submissions by email and webhook, own your data.';
	const ogImageUrl = `${siteUrl}/og-image.svg`;
	const repoUrl = 'https://github.com/megabudino/formlite';
	const zeromegaUrl = 'https://www.zeromega.it/en';
	const currentYear = new Date().getFullYear();
	const authorName = 'Davide Ruggeri';

	function serializeJsonLd(data: Record<string, unknown>): string {
		return JSON.stringify(data).replace(/</g, '\\u003c');
	}

	const websiteSchema = {
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: siteName,
		url: siteUrl,
		description: pageDescription,
		inLanguage: 'en'
	};

	const softwareSchema = {
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: siteName,
		url: siteUrl,
		description: pageDescription,
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'Linux, macOS, Windows',
		license: 'https://opensource.org/license/mit',
		codeRepository: repoUrl,
		image: ogImageUrl,
		author: {
			'@type': 'Person',
			name: authorName,
			url: zeromegaUrl
		},
		publisher: {
			'@type': 'Organization',
			name: 'Zeromega',
			url: zeromegaUrl
		},
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'USD'
		}
	};

	const jsonLdMarkup = `
		<script type="application/ld+json">${serializeJsonLd(websiteSchema)}<\/script>
		<script type="application/ld+json">${serializeJsonLd(softwareSchema)}<\/script>
	`;
</script>

<svelte:head>
	<title>{pageTitle}</title>
	<meta name="description" content={pageDescription} />
	<meta
		name="robots"
		content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
	/>
	<meta name="author" content={authorName} />
	<link rel="canonical" href={siteUrl} />
	<link rel="alternate" hreflang="en" href={siteUrl} />
	<link rel="alternate" hreflang="x-default" href={siteUrl} />
	<link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />

	<meta property="og:type" content="website" />
	<meta property="og:locale" content="en_US" />
	<meta property="og:site_name" content={siteName} />
	<meta property="og:title" content={pageTitle} />
	<meta property="og:description" content={pageDescription} />
	<meta property="og:url" content={siteUrl} />
	<meta property="og:image" content={ogImageUrl} />
	<meta property="og:image:alt" content="Formlite marketing preview" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={pageTitle} />
	<meta name="twitter:description" content={pageDescription} />
	<meta name="twitter:image" content={ogImageUrl} />
	<meta name="twitter:image:alt" content="Formlite marketing preview" />

	{@html jsonLdMarkup}
</svelte:head>

<div class="min-h-screen overflow-x-clip bg-bg text-fg">

<LandingHeader
	brand="Formlite"
	cta={{ label: 'View on GitHub', href: repoUrl, external: true }}
/>

<main>

<Hero
	headline="Forms that just"
	highlight="work."
	subhead="Point your HTML form at an endpoint. Submissions land in your inbox and your webhooks. No backend. No JavaScript. No one else owning your data."
	primaryCta={{ label: 'Get the source on GitHub', href: repoUrl, external: true }}
	note="Self hosted only. There is no SaaS to sign up to."
	footnote="MIT · Single Docker image · SQLite"
/>

<ProductShowcase
	title="Every submission in one calm, fast inbox."
	subhead="See what's coming in, read each message in full and clear out the spam. Traffic, busiest forms and peak hours sit one click away."
	hero={{
		src: '/screenshots/formlite-overview-light.webp',
		alt: 'Formlite workspace overview: submissions and blocked spam over the last 7 days, submissions per form and a heatmap of when people write',
		width: 2880,
		height: 1812,
		label: 'forms.your-domain.com',
		mobile: { src: '/screenshots/formlite-overview-mobile.webp', width: 1170, height: 2080 }
	}}
	rows={[
		{
			src: '/screenshots/formlite-inbox-light.webp',
			alt: 'Formlite form inbox with a list of submissions and the selected message open on the right',
			width: 2880,
			height: 1800,
			mobile: { src: '/screenshots/formlite-inbox-mobile.webp', width: 1170, height: 2080 },
			title: 'Read, reply, clean up',
			body: 'Each form gets its own inbox. Open a message, reply by email in one click, select and delete in bulk.'
		},
		{
			src: '/screenshots/formlite-dashboard-light.webp',
			alt: 'Formlite dashboard with three workspaces and a 30-day sparkline of submissions for each',
			width: 2240,
			height: 1000,
			mobile: { src: '/screenshots/formlite-dashboard-mobile.webp', width: 1170, height: 2080 },
			title: 'One place for every site',
			body: 'Group forms into workspaces per client or project, and see at a glance which ones are busy.'
		}
	]}
/>

<PainPoints
	title="The form SaaS bill keeps growing. And the data isn't even yours."
	items={[
		{
			icon: 'dollar',
			title: 'Tired of monthly fees',
			body: "Form SaaS charges per submission, per form, per seat. For a static site that ships one form, the math stops making sense fast."
		},
		{
			icon: 'shield',
			title: 'Tired of giving away your leads',
			body: "Your contact requests, job applications, and sales leads live in someone else's database. You want them in yours."
		},
		{
			icon: 'code',
			title: 'Tired of "just spin up a backend"',
			body: "You don't want to write a controller, configure SMTP, store submissions, sign webhooks. You want it to already exist."
		}
	]}
/>

<Bridge
	quote="Self hosting a form endpoint shouldn't take a weekend. With Formlite it takes ten minutes."
/>

<CoreOffer
	title="A form endpoint you drop into your HTML. On your server. For free."
	body="Formlite is a small, fast, multi tenant form backend you self host in a single Docker container. Create a form, point your form action at it, and submissions land in your inbox and your webhooks. Signed. Spam filtered. Stored in your own SQLite database."
	features={[
		{ icon: 'mail', label: 'Email notifications via Mailgun' },
		{ icon: 'webhook', label: 'HMAC signed webhooks' },
		{ icon: 'shield', label: 'Honeypot spam protection' },
		{ icon: 'globe', label: 'Domain allowlist' },
		{ icon: 'folder', label: 'Multi workspace. Multi form.' },
		{ icon: 'inbox', label: 'One container. One volume. Done.' }
	]}
	primaryCta={{ label: 'Get the source on GitHub', href: repoUrl, external: true }}
/>

<Team
	title="Made by a small studio that builds websites."
	members={[
		{
			name: 'Davide Ruggeri',
			role: 'Author & maintainer',
			bio: "Founder of Zeromega, a studio specialised in websites. We build them, look after them and grow their traffic and conversions.",
			avatarUrl: 'https://www.zeromega.it/images/davide-di-zeromega.webp',
			link: { label: 'zeromega.it', href: zeromegaUrl }
		}
	]}
/>

<FinalCta
	title="Stop renting your form backend."
	body="Clone the repo. Run one container. Point your form at it. That's the whole onboarding."
	primaryCta={{ label: 'Get the source on GitHub', href: repoUrl, external: true }}
	note="MIT · Single Docker image · SQLite"
/>

</main>

<Footer
	tagline="Formlite. The form backend you actually own."
	byline={{
		text: 'Crafted by Davide Ruggeri at',
		linkLabel: 'Zeromega',
		linkHref: zeromegaUrl
	}}
	links={[
		{ label: 'GitHub', href: repoUrl, external: true, icon: 'github' },
		{ label: 'Zeromega', href: zeromegaUrl, external: true, icon: 'globe' }
	]}
	legal={`© ${currentYear} Davide Ruggeri · Zeromega. The studio specialised in websites.`}
/>

</div>
